@startuml C4_Context_Future20
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

title C4 Level 1 — System Context: «Будущее 2.0» (целевая архитектура, год 3)

' ─── Акторы ───────────────────────────────────────────────────────────────
Person(patient,   "Пациент / Клиент",    "Записывается на приём, получает медицинские\nи финансовые услуги через цифровые каналы")
Person(doctor,    "Врач / Оператор",     "Ведёт пациентов, назначает лечение,\nработает с операционной системой клиники")
Person(analyst,   "Бизнес-аналитик",    "Строит отчёты и дашборды\nчерез портал самообслуживания")
Person(regulator, "Регулятор",          "ЦБ РФ, Росздравнадзор — получают\nрегуляторную отчётность")

' ─── Центральная система ──────────────────────────────────────────────────
System(future20, "Будущее 2.0",\n«Экосистема», "Событийная платформа: медицинские сервисы,\nбанк, ИИ-диагностика, портал данных.\nYandex Cloud, Kafka, ClickHouse.")

' ─── Внешние системы ──────────────────────────────────────────────────────
System_Ext(pharma,     "Фармацевтический партнёр", "Данные о препаратах,\nпоставки, интеграция через Kafka")
System_Ext(meddevice,  "Производитель мед. оборудования", "Телеметрия устройств,\nрезультаты измерений (IoT)")
System_Ext(cbrf,       "ЦБ РФ / НСПК",            "Банковский клиринг,\nпереводы, отчётность")
System_Ext(ehr,        "ЕГИСЗ",                    "Федеральный реестр\nмедицинских данных РФ")

' ─── Отношения ────────────────────────────────────────────────────────────
Rel(patient,   future20, "Записывается, получает услуги",      "HTTPS / Mobile App")
Rel(doctor,    future20, "Ведёт пациентов, вносит данные",     "HTTPS (Clinic Web UI)")
Rel(analyst,   future20, "Строит отчёты",                      "HTTPS (Self-Service Portal)")
Rel(regulator, future20, "Получает регуляторную отчётность",   "Защищённый канал / API")

Rel(future20, pharma,    "Получает данные о препаратах",        "Kafka / REST API")
Rel(future20, meddevice, "Получает телеметрию устройств",       "Kafka / MQTT")
Rel(future20, cbrf,      "Банковские операции, отчётность",     "SWIFT / ФинТех API")
Rel(future20, ehr,       "Передаёт / получает медданные",       "HL7 FHIR / API ЕГИСЗ")

@enduml
